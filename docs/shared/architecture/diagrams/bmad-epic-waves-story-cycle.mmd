flowchart TD
    N(["nó do DOT: story-key<br/>cd worktree && ..."]) --> PREP["prepare<br/>bmad_epic_waves_integrate<br/>valida worktree/branch, flock"]
    PREP -->|"&&"| CYC

    subgraph CYC["bmad-story-cycle.yaml — in_worktree=true"]
        IP["init_policy<br/>max_review_cycles + review_handoff<br/>(0/1 -> handoff manual)"]
        IP --> ESF
        ESF{"ensure_story_file"}
        ESF -->|"sem arquivo e create_if_missing=false"| MSF(["missing_story_file"]):::abort
        ESF -->|"criar"| CS["create_story"] --> RCP["resolve_created_path"] --> DEV
        ESF -->|"existe"| DEV

        DEV["dev_story<br/>provider pela rota da story:<br/>trivial/small/standard/frontier"]
        DEV --> PD{"parse_dev<br/>FINAL_STATUS,<br/>VERIFICATION_INCOMPLETE"}
        PD -->|"morreu sem report: retry único"| DEV
        PD -->|"max_review_cycles = 0<br/>sem review automático"| FS
        PD --> CR["code_review<br/>review adversarial,<br/>nunca cai de esforço junto com o dev"]

        CR --> CRS{"check_review_status"}
        CRS -->|"RETRY"| CR
        CRS -->|"CHANGES_REQUESTED e<br/>attempt < max_review_cycles"| FR["fix_review<br/>fix_provider promovido;<br/>2º fix vai a frontier"]
        CRS -->|"ciclos esgotados + handoff manual:<br/>FINAL_FIX (um fix, sem re-review)"| FR
        FR --> PF{"post_fix"}
        PF -->|"fix normal"| CR
        PF -->|"fix final"| FS
        CRS -->|"APPROVED"| FS["finish_story<br/>reconfere suíte + File List,<br/>commit nominal no branch,<br/>NÃO toca sprint-status"]
        CRS -->|"BLOCKED (sempre)<br/>MAX_ATTEMPTS com handoff=block"| SM
        FS --> SM["summary<br/>completed | manual_review | incomplete"]
    end

    CYC -->|"--fail-on-state final_status=incomplete<br/>--fail-on-state missing_story_file"| RC{"exit code"}
    RC -->|"≠ 0: o && corta"| NOMERGE(["nada de merge<br/>branch story/key preservada"]):::abort
    RC -->|"0"| MRG["merge no branch alvo<br/>+ marca sprint-status<br/>serializado pelo mesmo lock"]
    MRG -->|"final_status=completed"| OK(["story integrada — done"])
    MRG -->|"final_status=manual_review"| MR(["story integrada — review<br/>pendente do review humano"]):::pending

    classDef abort fill:#fdecea,stroke:#c0392b,color:#7b241c
    classDef pending fill:#fef5e7,stroke:#b9770e,color:#7e5109
